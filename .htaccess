<IfModule mod_rewrite.c>
    RewriteEngine On
    AddDefaultCharset UTF-8

    # =========================================================================
    # Security Headers
    # =========================================================================
    <IfModule mod_headers.c>
        # Prevent MIME type sniffing
        Header always set X-Content-Type-Options "nosniff"

        # Protect user privacy while keeping analytics functional
        Header always set Referrer-Policy "strict-origin-when-cross-origin"

        # Prevent clickjacking (fallback for older browsers)
        Header always set X-Frame-Options "SAMEORIGIN"

        # Content Security Policy
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://www.google-analytics.com https://cdn.jsdelivr.net; connect-src 'self' https://www.google-analytics.com; frame-src 'self' https://www.google.com https://maps.google.com; frame-ancestors 'self';"

        # HSTS (Uncomment when SSL is fully set up and you want to enforce HTTPS)
        # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    </IfModule>

    # =========================================================================
    # 1. 301 Permanent Redirects for Berber Magic Tours (Old -> New Clean URLs)
    # =========================================================================
    
    # --- Main Navigation Pages (Old URLs -> New Slugs) ---
    RewriteRule ^about/?$ https://berber-magic-tours.com/about-us [R=301,L]
    RewriteRule ^trek-hike/?$ https://berber-magic-tours.com/trek-and-hike [R=301,L]
    RewriteRule ^combine-atlas-sahara/?$ https://berber-magic-tours.com/combine-toubkal-and-villages [R=301,L]
    RewriteRule ^faqs/?$ https://berber-magic-tours.com/faq [R=301,L]
    RewriteRule ^contact-us/?$ https://berber-magic-tours.com/contact [R=301,L]


    # --- Tour Packages ---
    # Azzaden Valley: legacy root URL → canonical /tours/ page (301)
    RewriteRule ^2-days-azzaden-valley-trek/?$ https://berber-magic-tours.com/tours/2days-azzaden-valley [R=301,L]
    RewriteRule ^package/2days-azzaden-valley/?$ https://berber-magic-tours.com/tours/2days-azzaden-valley [R=301,L]
    RewriteRule ^package/2-days-mount-toubkal/?$ https://berber-magic-tours.com/tours/2-days-mount-toubkal [R=301,L]
    RewriteRule ^package/overnight-in-atlas-mountains/?$ https://berber-magic-tours.com/tours/overnight-in-atlas-mountains [R=301,L]
    RewriteRule ^package/mount-toubkal-3days-trek-acclimatization/?$ https://berber-magic-tours.com/tours/mount-toubkal-3days-trek-acclimatization [R=301,L]
    RewriteRule ^package/3-days-atlas-mountains-trek-camel-ride/?$ https://berber-magic-tours.com/tours/3-days-atlas-mountains-trek-camel-ride [R=301,L]
    RewriteRule ^package/5-days-atlas-mountain-trek/?$ https://berber-magic-tours.com/tours/5-days-atlas-mountain-trek [R=301,L]
    RewriteRule ^package/3days-merzouga-desert/?$ https://berber-magic-tours.com/tours/3days-merzouga-desert [R=301,L]
    RewriteRule ^package/4days-sahara-desert/?$ https://berber-magic-tours.com/tours/4days-sahara-desert [R=301,L]
    RewriteRule ^package/4-days-sahara-desert-marrakech-to-fes/?$ https://berber-magic-tours.com/tours/4-days-sahara-desert-marrakech-to-fes [R=301,L]
    RewriteRule ^package/5days-berber-villagessahara/?$ https://berber-magic-tours.com/tours/5days-berber-villagessahara [R=301,L]
    RewriteRule ^package/7days-berber-villagessahara/?$ https://berber-magic-tours.com/tours/7days-berber-villagessahara [R=301,L]
    RewriteRule ^package/6days-berber-villagessahara/?$ https://berber-magic-tours.com/tours/6days-berber-villagessahara [R=301,L]
    RewriteRule ^package/best-of-morocco-holidays/?$ https://berber-magic-tours.com/tours/best-of-morocco-holidays [R=301,L]
    RewriteRule ^package/6days-imperial-cities-desert/?$ https://berber-magic-tours.com/tours/6days-imperial-cities-desert [R=301,L]
    RewriteRule ^package/5-days-imperial-cities/?$ https://berber-magic-tours.com/tours/5-days-imperial-cities [R=301,L]

    # =========================================================================
    # 2. Redirect external .html requests to clean URLs (e.g. /contact.html -> /contact)
    # =========================================================================
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # =========================================================================
    # 3. Resolve extensionless URLs to .html files internally
    # =========================================================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L,QSA]

    # Handle 404 errors
    ErrorDocument 404 /404.html

</IfModule>

# =============================================================================
# HTTP Caching Policy
# =============================================================================

<IfModule mod_headers.c>

    # -------------------------------------------------------------------------
    # HTML pages: revalidate on every request so content changes are seen fast.
    # -------------------------------------------------------------------------
    <FilesMatch "\.(html|htm)$">
        Header always set Cache-Control "no-cache, must-revalidate"
        Header always set Vary "Accept-Encoding"
    </FilesMatch>

    # -------------------------------------------------------------------------
    # Versioned CSS / JS (references now include ?v=<hash>).
    # Apache ignores query strings for FilesMatch, so we use long max-age and
    # let the version query string act as the cache-buster.
    # -------------------------------------------------------------------------
    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # -------------------------------------------------------------------------
    # Fonts: immutable – never change once published.
    # -------------------------------------------------------------------------
    <FilesMatch "\.(woff2|woff|ttf|eot|otf)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
        Header always set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # -------------------------------------------------------------------------
    # Images: long cache; use versioned URLs or filename changes to bust.
    # -------------------------------------------------------------------------
    <FilesMatch "\.(webp|avif|jpg|jpeg|png|gif|svg|ico)$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # -------------------------------------------------------------------------
    # JSON / XML (sitemap, schema): short-lived so crawlers pick up changes.
    # -------------------------------------------------------------------------
    <FilesMatch "\.(xml|json)$">
        Header always set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # -------------------------------------------------------------------------
    # PHP form responses: must never be cached.
    # -------------------------------------------------------------------------
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, private"
    </FilesMatch>

</IfModule>

# =============================================================================
# Compression – Brotli preferred, gzip fallback
# =============================================================================

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml text/plain font/woff2 font/woff
    BrotliCompressionQuality 6
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml text/plain font/woff2 font/woff
    # Skip already-compressed formats
    SetEnvIfNoCase Request_URI \.(webp|avif|jpg|jpeg|png|gif|gz|br)$ no-gzip dont-vary
</IfModule>